<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == ''">Win32</Platform>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v142</PlatformToolset>
  </PropertyGroup>

  <!--
    OpenSSL is downloaded at build time (see download-openssl.ps1 /
    openssl.vcxproj on Windows, build-common.sh on Unix) rather than
    vendored; the version pin lives in MagPython/openssl-version so
    every consumer reads the same value. OpenSslDllSuffix is the
    soname suffix embedded in Windows DLL names (libcrypto-3.dll on
    the 3.x line, libcrypto-4.dll in a hypothetical future major bump).
    On the 3.x line OpenSSL's SHLIB_VERSION always equals MAJOR, so we
    derive the suffix from the major component of the pinned version
    rather than parsing VERSION.dat (which doesn't exist before the
    download has run).
  -->
  <PropertyGroup>
    <_OpenSslVersionRaw>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)openssl-version'))</_OpenSslVersionRaw>
    <OpenSslVersion>$(_OpenSslVersionRaw.Trim())</OpenSslVersion>
    <OpenSslDllSuffix>$([System.Text.RegularExpressions.Regex]::Match('$(OpenSslVersion)', '^([0-9]+)').Groups[1].Value)</OpenSslDllSuffix>
  </PropertyGroup>

  <!--
    libmpdec is downloaded at build time (see download-libmpdec.ps1 /
    LibMpdec.vcxproj on Windows, build-common.sh on Unix) rather than
    vendored; the version pin lives in MagPython/libmpdec-version so
    every consumer reads the same value.
  -->
  <PropertyGroup>
    <_LibMpdecVersionRaw>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)libmpdec-version'))</_LibMpdecVersionRaw>
    <LibMpdecVersion>$(_LibMpdecVersionRaw.Trim())</LibMpdecVersion>
  </PropertyGroup>

  <!--
    zlib is downloaded at build time (see download-zlib.ps1 /
    ZLib.vcxproj on Windows, build-common.sh on Unix) rather than
    vendored; the version pin lives in MagPython/zlib-version so
    every consumer reads the same value.
  -->
  <PropertyGroup>
    <_ZlibVersionRaw>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)zlib-version'))</_ZlibVersionRaw>
    <ZlibVersion>$(_ZlibVersionRaw.Trim())</ZlibVersion>
  </PropertyGroup>

  <!--
    libffi is downloaded at build time (see download-libffi.ps1 /
    LibFFI.vcxproj on Windows, build-common.sh on Unix) rather than
    vendored; the version pin lives in MagPython/libffi-version so
    every consumer reads the same value.
  -->
  <PropertyGroup>
    <_LibFFIVersionRaw>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)libffi-version'))</_LibFFIVersionRaw>
    <LibFFIVersion>$(_LibFFIVersionRaw.Trim())</LibFFIVersion>
  </PropertyGroup>
</Project>
