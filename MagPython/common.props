<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == ''">Win32</Platform>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v142</PlatformToolset>
  </PropertyGroup>

  <!--
    Version pins for the build-time-downloaded deps. Each dep has a
    single-line MagPython/<dep>-version pin that this file slurps into
    a $(...Version) property; the vcxprojs (and via them the metaproj)
    substitute it into cache paths like
    $(MSBuildThisFileDirectory)\<dep>\<dep>-$(...Version)\. The matching
    SHA-256 pin and the actual download/extract logic live in
    download-<dep>.ps1 (Windows) and setup_<dep> in build-common.sh
    (Unix); see README's "Updating pinned <dep>" sections for per-dep
    specifics.

    OpenSslDllSuffix and OpenSslShlibVariant are the only computed
    properties here. OpenSslDllSuffix is the soname suffix embedded in
    Windows DLL names (libcrypto-3.dll on the 3.x line). On the 3.x line
    OpenSSL's SHLIB_VERSION always equals MAJOR, so we derive the suffix
    from the major component of the pinned version rather than parsing
    VERSION.dat (which doesn't exist before the download has run).

    OpenSslShlibVariant is OpenSSL's per-target shlib_variant — empty on
    Win32, "-x64" on x64 (defined for VC-WIN64-common in OpenSSL's
    Configurations/10-main.conf). Without this the x64 DLLs come out
    named libcrypto-3-x64.dll / libssl-3-x64.dll and openssl.vcxproj's
    CopyArtifacts can't find them.
  -->
  <PropertyGroup>
    <_OpenSslVersionRaw>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)openssl-version'))</_OpenSslVersionRaw>
    <OpenSslVersion>$(_OpenSslVersionRaw.Trim())</OpenSslVersion>
    <OpenSslDllSuffix>$([System.Text.RegularExpressions.Regex]::Match('$(OpenSslVersion)', '^([0-9]+)').Groups[1].Value)</OpenSslDllSuffix>
    <OpenSslShlibVariant Condition="'$(Platform)' == 'x64'">-x64</OpenSslShlibVariant>
    <OpenSslShlibVariant Condition="'$(OpenSslShlibVariant)' == ''"></OpenSslShlibVariant>

    <_LibMpdecVersionRaw>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)libmpdec-version'))</_LibMpdecVersionRaw>
    <LibMpdecVersion>$(_LibMpdecVersionRaw.Trim())</LibMpdecVersion>

    <_ZlibVersionRaw>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)zlib-version'))</_ZlibVersionRaw>
    <ZlibVersion>$(_ZlibVersionRaw.Trim())</ZlibVersion>

    <_ZStdVersionRaw>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)zstd-version'))</_ZStdVersionRaw>
    <ZStdVersion>$(_ZStdVersionRaw.Trim())</ZStdVersion>

    <_LibFFIVersionRaw>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)libffi-version'))</_LibFFIVersionRaw>
    <LibFFIVersion>$(_LibFFIVersionRaw.Trim())</LibFFIVersion>

    <_SQLiteVersionRaw>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)sqlite-version'))</_SQLiteVersionRaw>
    <SQLiteVersion>$(_SQLiteVersionRaw.Trim())</SQLiteVersion>

    <_PythonVersionRaw>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)python-version'))</_PythonVersionRaw>
    <PythonVersion>$(_PythonVersionRaw.Trim())</PythonVersion>
    <!--
      FIELD3 is upstream's stand-in for the patch-level number embedded in
      the Windows VERSIONINFO resource (PC/python_ver_rc.h's
      PYVERSION64 = MAJOR, MINOR, FIELD3, PYTHON_API_VERSION). Upstream's
      PCbuild/python.props parses Include/patchlevel.h to compute it as
      `micro * 1000 + ReleaseLevelNumber * 10 + serial`. We always pin to
      stable releases (update-python.sh enforces same-major bumps and
      CPython only does pre-releases for X.Y.0), so ReleaseLevelNumber is
      always 15 (final) and serial 0 — derive FIELD3 directly from the
      pinned version's micro component. Consumed by MagPythonExe.vcxproj
      as a ResourceCompile preprocessor define when building the
      MagPython.exe version-info / manifest resources.
    -->
    <PythonMicroVersion>$([System.Text.RegularExpressions.Regex]::Match('$(PythonVersion)', '^\d+\.\d+\.(\d+)').Groups[1].Value)</PythonMicroVersion>
    <PythonField3Value>$([MSBuild]::Add($([MSBuild]::Multiply($(PythonMicroVersion), 1000)), 150))</PythonField3Value>
  </PropertyGroup>
</Project>
