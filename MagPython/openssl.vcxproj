<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{37DFD855-7BB5-41C5-A7D0-DE690D35C9A9}</ProjectGuid>
  </PropertyGroup>
  <Import Project="common.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup>
    <ProjectName>openssl</ProjectName>
    <ConfigurationType>Makefile</ConfigurationType>
    <!-- Source tree exists at $(BuildDir) only after Download openssl runs;
         common.props derives $(OpenSslVersion) from MagPython/openssl-version. -->
    <BuildDir>$(MSBuildProjectDirectory)\openssl\openssl-$(OpenSslVersion)</BuildDir>
    <OutDir>$(MSBuildProjectDirectory)\$(Configuration)\</OutDir>
    <!-- OpenSSL's per-target Configure name. The 32-bit toolchain uses
         VC-WIN32-ONECORE (x86 ASM), the 64-bit toolchain uses
         VC-WIN64A-ONECORE (AMD64 ASM). Both ONECORE variants link
         against api-ms-win-* umbrella libs rather than the full
         kernel32 surface — same baseline policy for both architectures. -->
    <OpenSslConfigureTarget Condition="'$(Platform)' == 'Win32'">VC-WIN32-ONECORE</OpenSslConfigureTarget>
    <OpenSslConfigureTarget Condition="'$(Platform)' == 'x64'">VC-WIN64A-ONECORE</OpenSslConfigureTarget>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <NMakeBuildCommandLine>
      cd /D "$(BuildDir)"
      set PATH=$(MSBuildProjectDirectory)\nasm;$(MSBuildProjectDirectory)\jom;%PATH%
      rem /FS serialises cl's writes to ossl_static.pdb so the parallel
      rem jobs jom spawns don't collide on it (without /FS the build dies
      rem with "cannot open program database ... if multiple CL.EXE write
      rem to the same .PDB file, please use /FS").
      set CL=/FS
      perl Configure no-makedepend $(OpenSslConfigureTarget) no-idea no-mdc2 no-cms no-comp no-ct no-engine no-dso no-ocsp no-srp no-srtp no-ssl3 no-ts no-tests no-async no-fips no-docs no-legacy no-cmp no-apps
      jom -j%NUMBER_OF_PROCESSORS% build_libs
    </NMakeBuildCommandLine>
    <NMakeOutput />
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="Download openssl" BeforeTargets="Build">
    <Exec Command="powershell.exe -NonInteractive -executionpolicy Unrestricted -file $(MSBuildProjectDirectory)\download-openssl.ps1" />
  </Target>
  <Target Name="Download nasm" BeforeTargets="Build">
    <Exec Command="powershell.exe -NonInteractive -executionpolicy Unrestricted -file $(MSBuildProjectDirectory)\download-nasm.ps1" />
  </Target>
  <Target Name="Download jom" BeforeTargets="Build">
    <Exec Command="powershell.exe -NonInteractive -executionpolicy Unrestricted -file $(MSBuildProjectDirectory)\download-jom.ps1" />
  </Target>
  <Target Name="CopyArtifacts" AfterTargets="Build">
    <ItemGroup>
      <!-- Contents of include\... changes after nmake. This ItemGroup must be INSIDE the CopyArtifacts Target,
           otherwise it gets evaluated too early. -->
      <BuiltIncludeCrypto Include="$(BuildDir)\include\crypto\**\*.h" />
      <BuiltIncludeOpenSSL Include="$(BuildDir)\include\openssl\**\*.h" />
      <!-- $(OpenSslShlibVariant) is "-x64" on x64 (OpenSSL's per-target
           shlib_variant — see common.props) and empty on Win32. The
           import libs (.lib) never get the variant suffix; only the
           DLLs do. -->
      <LibraryFiles Include="$(BuildDir)\libcrypto-$(OpenSslDllSuffix)$(OpenSslShlibVariant).dll" />
      <LibraryFiles Include="$(BuildDir)\libcrypto.lib" />
      <LibraryFiles Include="$(BuildDir)\libssl-$(OpenSslDllSuffix)$(OpenSslShlibVariant).dll" />
      <LibraryFiles Include="$(BuildDir)\libssl.lib" />
      <LibraryFiles Include="$(BuildDir)\ms\applink.c" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)" />
    <Copy SourceFiles="@(LibraryFiles)" DestinationFolder="$(OutDir)" />
    <MakeDir Directories="$(OutDir)\include" />
    <MakeDir Directories="$(OutDir)\include\crypto" />
    <Copy SourceFiles="@(BuiltIncludeCrypto)" DestinationFolder="$(OutDir)\include\crypto\%(RecursiveDir)" />
    <MakeDir Directories="$(OutDir)\include\openssl" />
    <Copy SourceFiles="@(BuiltIncludeOpenSSL)" DestinationFolder="$(OutDir)\include\openssl\%(RecursiveDir)" />
  </Target>
  <!--
    Sanity-check the staged OpenSSL install (libssl-N.dll / libcrypto-N.dll
    + import libs + headers in $(OutDir)) by compiling and running
    MagPython/openssl-verify.c against it. Catches a misconfigured no-* set
    or a missing soname here, with a clear error, instead of surfacing later
    as a baffling MagPython.dll link failure.
  -->
  <Target Name="VerifyOpenSSL" AfterTargets="CopyArtifacts">
    <Exec Command="cl /nologo /MD /I &quot;$(OutDir)include&quot; &quot;$(MSBuildProjectDirectory)\openssl-verify.c&quot; /Fe&quot;$(OutDir)openssl-verify.exe&quot; /Fo&quot;$(OutDir)openssl-verify.obj&quot; /link &quot;$(OutDir)libssl.lib&quot; &quot;$(OutDir)libcrypto.lib&quot;" />
    <Exec Command="&quot;$(OutDir)openssl-verify.exe&quot;" WorkingDirectory="$(OutDir)" />
    <Delete Files="$(OutDir)openssl-verify.exe;$(OutDir)openssl-verify.obj" />
  </Target>
  <Target Name="Clean">
    <RemoveDir Directories="$(OutDir)" />
  </Target>
  <Target Name="CleanAll">
    <RemoveDir Directories="$(OutDir)" />
  </Target>
</Project>
