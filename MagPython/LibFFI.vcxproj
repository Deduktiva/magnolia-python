<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" InitialTargets="DownloadLibffi;RegenLibffiMsvcHeaders" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{36DFC1C0-EB3A-48D0-8E5B-A09387F102E2}</ProjectGuid>
    <TargetName>libffi</TargetName>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>LibFFI</RootNamespace>
    <ProjectName>LibFFI</ProjectName>
  </PropertyGroup>
  <Import Project="common.props" />
  <PropertyGroup>
    <TopDir>$(MSBuildProjectDirectory)\..\</TopDir>
    <IntDir>$(MSBuildProjectDirectory)\$(Configuration)-Int-libffi\</IntDir>
    <OutDir>$(MSBuildProjectDirectory)\$(Configuration)\</OutDir>
    <!-- libffi source is downloaded at build time (see
         download-libffi.ps1 / setup_libffi in build-common.sh) into
         the per-version cache dir below. The Download libffi target
         declared further down runs before any C/asm compile, so the
         <ClCompile> + <CustomBuild> items resolve their files at
         build time even though they reference paths that don't exist
         on a fresh clone. -->
    <SourceDir>$(MSBuildProjectDirectory)\libffi\libffi-$(LibFFIVersion)\</SourceDir>
    <!-- Both the x86_win32 (32-bit) and x86_win64 (64-bit AMD64) MSVC variants
         live under src/x86/ upstream; the difference is which .c/.S pair
         compiles and which @TARGET@ token ffi.h is generated for. -->
    <LibFFITarget Condition="'$(Platform)' == 'Win32'">X86_WIN32</LibFFITarget>
    <LibFFITarget Condition="'$(Platform)' == 'x64'">X86_WIN64</LibFFITarget>
    <LibFFISourceDir>$(SourceDir)\src</LibFFISourceDir>
    <LibFFITargetSourceDir>$(SourceDir)\src\x86</LibFFITargetSourceDir>
    <!-- ffi.h and fficonfig.h come out of an autoconf-driven
         ./configure run (RegenLibffiMsvcHeaders below). Per-Platform
         builddir so x86 and x64 outputs don't share state. -->
    <LibFFIGeneratedBuildDir>$(SourceDir)\magpython-msvc-build-$(Platform)</LibFFIGeneratedBuildDir>
    <LibFFIGeneratedIncludeDir>$(LibFFIGeneratedBuildDir)\include</LibFFIGeneratedIncludeDir>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup>
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <!-- _M_IX86 vs _M_AMD64 is auto-defined by MSVC at the right times,
           but libffi src checks them with #ifdef, so set them explicitly to
           match the active platform. $(LibFFITarget) (X86_WIN32 / X86_WIN64)
           is what picks the per-arch codepath inside the libffi sources. -->
      <PreprocessorDefinitions>_WIN32;X86;$(LibFFITarget);FFI_STATIC_BUILD;USE_DL_PREFIX;NDEBUG;_LIB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Platform)' == 'Win32'">_M_IX86;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Platform)' == 'x64'">_WIN64;_M_AMD64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalIncludeDirectories>$(LibFFIGeneratedIncludeDir);$(LibFFIGeneratedBuildDir);$(SourceDir)\include;$(LibFFITargetSourceDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <OmitFramePointers>true</OmitFramePointers>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <EnableFiberSafeOptimizations>true</EnableFiberSafeOptimizations>
      <AdditionalUsingDirectories>$(LibFFISourceDir);$(LibFFITargetSourceDir);$(LibFFIGeneratedIncludeDir);$(LibFFIGeneratedBuildDir);%(AdditionalUsingDirectories)</AdditionalUsingDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="$(LibFFIGeneratedIncludeDir)\ffi.h" />
    <ClInclude Include="$(LibFFIGeneratedBuildDir)\fficonfig.h" />
    <ClInclude Include="$(SourceDir)\include\ffi_cfi.h" />
    <ClInclude Include="$(SourceDir)\include\ffi_common.h" />
    <ClInclude Include="$(LibFFITargetSourceDir)\asmnames.h" />
    <ClInclude Include="$(LibFFITargetSourceDir)\ffitarget.h" />
    <ClInclude Include="$(LibFFITargetSourceDir)\internal.h" />
  </ItemGroup>
  <!-- Win32 (x86): src/x86/ffi.c + sysv_intel.S, assembled with ml.exe.
       x64 (AMD64): src/x86/ffiw64.c + win64_intel.S, assembled with ml64.exe.
       Both .S files are CPP-style assembly: cl /FA /EP preprocesses to asm.i,
       then the architecture-matching MASM dialect (ml / ml64) consumes it. -->
  <ItemGroup>
    <ClCompile Include="$(LibFFISourceDir)\closures.c" />
    <ClCompile Include="$(LibFFISourceDir)\prep_cif.c" />
    <ClCompile Include="$(LibFFISourceDir)\types.c" />
    <ClCompile Include="$(LibFFITargetSourceDir)\ffi.c" Condition="'$(Platform)' == 'Win32'" />
    <ClCompile Include="$(LibFFITargetSourceDir)\ffiw64.c" Condition="'$(Platform)' == 'x64'" />
  </ItemGroup>
  <ItemGroup Condition="'$(Platform)' == 'Win32'">
    <CustomBuild Include="$(LibFFITargetSourceDir)\sysv_intel.S">
      <Command>
        cd "$(IntDir)"
        cl /FA /EP /nologo /I"$(LibFFIGeneratedIncludeDir)" /I"$(LibFFIGeneratedBuildDir)" /I"$(SourceDir)\include" /I"$(LibFFITargetSourceDir)" "%(FullPath)" &gt; asm.i
        ml /safeseh /c /I"$(SourceDir)\src" /I"$(LibFFIGeneratedIncludeDir)" /I"$(LibFFIGeneratedBuildDir)" /I"$(SourceDir)\include" /I"$(LibFFITargetSourceDir)" /Foasm.obj asm.i
      </Command>
      <Outputs>$(IntDir)asm.obj;%(Outputs)</Outputs>
    </CustomBuild>
  </ItemGroup>
  <ItemGroup Condition="'$(Platform)' == 'x64'">
    <CustomBuild Include="$(LibFFITargetSourceDir)\win64_intel.S">
      <Command>
        cd "$(IntDir)"
        cl /FA /EP /nologo /I"$(LibFFIGeneratedIncludeDir)" /I"$(LibFFIGeneratedBuildDir)" /I"$(SourceDir)\include" /I"$(LibFFITargetSourceDir)" "%(FullPath)" &gt; asm.i
        ml64 /c /I"$(SourceDir)\src" /I"$(LibFFIGeneratedIncludeDir)" /I"$(LibFFIGeneratedBuildDir)" /I"$(SourceDir)\include" /I"$(LibFFITargetSourceDir)" /Foasm.obj asm.i
      </Command>
      <Outputs>$(IntDir)asm.obj;%(Outputs)</Outputs>
    </CustomBuild>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Download libffi runs as InitialTargets on the Project root rather
       than BeforeTargets="Build" because LibFFI.vcxproj is a
       StaticLibrary type project: its Build is implemented as a chain
       (BuildGenerateSources -> BuildCompile -> BuildLink), and CustomBuild
       items (sysv_intel.S below) execute under BuildGenerateSources
       before BeforeTargets="Build" hooks fire. InitialTargets runs
       unconditionally as the first thing for any MSBuild invocation of
       this project, so the cache is populated before any source-file
       reference is resolved. The Makefile-type vcxprojs (openssl, ZLib,
       LibMpdec) get away with BeforeTargets="Build" because their Build
       is monolithic. -->
  <Target Name="DownloadLibffi">
    <Exec Command="powershell.exe -NonInteractive -executionpolicy Unrestricted -file $(MSBuildProjectDirectory)\download-libffi.ps1" />
  </Target>
  <!-- Runs after DownloadLibffi (InitialTargets ordering). Needs MSYS2
       bash + autotools on PATH and cl.exe inherited from the enclosing
       Developer Command Prompt — the script enforces both up front. -->
  <Target Name="RegenLibffiMsvcHeaders">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)\build-libffi-msvc-headers.sh&quot; $(Platform)" />
  </Target>
  <ItemGroup>
    <PublicHeader Include="$(LibFFIGeneratedIncludeDir)\ffi.h" />
    <PublicHeader Include="$(LibFFIGeneratedBuildDir)\fficonfig.h" />
    <PublicHeader Include="$(LibFFITargetSourceDir)\ffitarget.h" />
  </ItemGroup>
  <Target Name="CopyArtifacts" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)" />
    <MakeDir Directories="$(OutDir)\include" />
    <Copy SourceFiles="@(PublicHeader)" DestinationFolder="$(OutDir)\include\" />
  </Target>
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
