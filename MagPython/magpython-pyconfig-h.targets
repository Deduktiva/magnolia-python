<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    Generate $(IntDir)\pyconfig.h from $(PythonSourceDir)\PC\pyconfig.h.in
    with one project-local edit:

      The libname pragma (#pragma comment(lib, "python313*.lib"))
      is rewritten to "MagPython.lib". The pragma only fires for
      consumers that don't define Py_BUILD_CORE / Py_BUILD_CORE_BUILTIN
      (i.e. extensions linking against MagPython.dll using our
      shipped headers), so this affects downstream linkage only.

    Until the windows-x64 PySide6 bundle landed, this targets file
    also commented out HAVE_DYNAMIC_LOADING: libMagPython.dll
    statically links every stdlib C extension it ships (see
    MagPython-config.c), so we didn't need the dynamic-loading code
    paths for our own modules. But abi3 .pyd files (PySide6.QtCore,
    shiboken6, anything a downstream `pip install`s) go through
    importlib's ExtensionFileLoader, which compiles out when
    HAVE_DYNAMIC_LOADING is undefined. Keeping the directive defined
    leaves the runtime cost in (~tens of KB of code) but is the price
    of admission for abi3 consumption.

    Doing the substitutions at build time (rather than editing
    PC\pyconfig.h.in in the imported tree) keeps the imported tree
    byte-identical to upstream, so update-python.sh's wipe-and-replace
    doesn't have to be followed by a manual re-patch step on Windows.

    This .targets file is imported by both MagPython.vcxproj (the
    main DLL) and FreezeMagPython.vcxproj (the build-time freeze
    tool); each project's $(IntDir) gets its own pyconfig.h.

    Importers must put $(IntDir) ahead of $(PythonSourceDir)\PC in
    <AdditionalIncludeDirectories> so the generated copy shadows any
    upstream pyconfig.h that may reappear in a future bump.
  -->
  <Target Name="GenerateMagPythonConfigH" BeforeTargets="ClCompile" Inputs="$(PythonSourceDir)\PC\pyconfig.h.in" Outputs="$(IntDir)pyconfig.h">
    <PropertyGroup>
      <_PyConfigSrc>$([System.IO.File]::ReadAllText('$(PythonSourceDir)\PC\pyconfig.h.in'))</_PyConfigSrc>
      <!-- Computed in PropertyGroup (rather than directly inside
           Condition="...") so property-function syntax stays out of
           the condition parser, which gets confused by file content
           containing quotes/=/etc. -->
      <_HasLibnamePragma>$(_PyConfigSrc.Contains('python313'))</_HasLibnamePragma>
      <_PyConfigPatched>$(_PyConfigSrc.Replace('"python313t_d.lib"', '"MagPython_d.lib"').Replace('"python313_d.lib"', '"MagPython_d.lib"').Replace('"python313t.lib"', '"MagPython.lib"').Replace('"python313.lib"', '"MagPython.lib"').Replace('"python3t.lib"', '"MagPython.lib"').Replace('"python3.lib"', '"MagPython.lib"'))</_PyConfigPatched>
    </PropertyGroup>
    <Error Text="GenerateMagPythonConfigH: libname pragma block (python313*.lib) not found in PC\pyconfig.h.in — upstream may have moved or renamed it; update the .Replace() chain in MagPython/magpython-pyconfig-h.targets." Condition="'$(_HasLibnamePragma)' != 'True'" />
    <MakeDir Directories="$(IntDir)" />
    <WriteLinesToFile File="$(IntDir)pyconfig.h" Lines="$(_PyConfigPatched)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
