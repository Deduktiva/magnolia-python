      <!-- getpath.c does #include "Python/frozen_modules/getpath.h"
           (regenerated by FreezeMagPython.vcxproj into
           $(PythonSourceDir)\Python\frozen_modules\). The other Python
           sources include frozen-module headers without the leading
           "Python/" path, so adding $(PythonSourceDir) globally would be
           overkill — scope it to this one file, mirroring upstream's
