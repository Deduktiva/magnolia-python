  <!-- CPython source download. Same InitialTargets pattern libffi uses:
       the project's hundreds of <ClCompile>/<ClInclude> refs into
       $(PythonSourceDir) need to resolve at build time, but
       BeforeTargets="Build" on a non-Makefile project fires too late
       (after CustomBuild/ClCompile have already tried to read the
       referenced files). InitialTargets runs unconditionally as the
       first thing for any MSBuild invocation of this project. -->
  <Target Name="DownloadPython">
    <Exec Command="powershell.exe -NonInteractive -executionpolicy Unrestricted -file $(MSBuildProjectDirectory)\download-python.ps1" />
  </Target>

  <Target Name="CopyArtifacts" AfterTargets="Build">
    <ItemGroup>
      <!-- Ship the build-time-generated pyconfig.h, not the upstream
           PC\pyconfig.h.in template. -->
      <ExtraIncludeFile Include="$(IntDir)pyconfig.h" />
      <IncludeFile Include="$(PythonSourceDir)\include\**\*" />
      <PythonFiles Include="$(PythonSourceDir)\lib\**\*.py" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)\include\Python" />
    <Copy SourceFiles="@(ExtraIncludeFile)" DestinationFolder="$(OutDir)\include\Python\" />
    <Copy SourceFiles="@(IncludeFile)" DestinationFolder="$(OutDir)\include\Python\%(RecursiveDir)" />
    <Copy SourceFiles="@(PythonFiles)" DestinationFolder="$(OutDir)\lib\%(RecursiveDir)" />
  </Target>

  <!-- Stage the upstream license / NOTICE files from each pinned dep into
       $(OutDir)\licenses\ as a flat tree of <dep>-license.txt files.
       Mirrors stage_licenses in build-common.sh so the windows-x86 zip
       carries the same licenses\ shape as the linux-x86_64 / macos-arm64
       zips. SQLite is special-cased because the amalgamation we devendor
       ships no separate LICENSE file — extract-sqlite-license.ps1 pulls
       the public-domain blessing out of sqlite3.h's leading comment
       block, version-aligned with the pin. -->
  <Target Name="StageLicenses" AfterTargets="CopyArtifacts">
    <ItemGroup>
      <_License Include="$(PythonSourceDir)\LICENSE">
        <DestName>cpython-license.txt</DestName>
      </_License>
      <_License Include="$(MSBuildProjectDirectory)\openssl\openssl-$(OpenSslVersion)\LICENSE.txt">
        <DestName>openssl-license.txt</DestName>
      </_License>
      <_License Include="$(MSBuildProjectDirectory)\libffi\libffi-$(LibFFIVersion)\LICENSE">
        <DestName>libffi-license.txt</DestName>
      </_License>
      <_License Include="$(MSBuildProjectDirectory)\libmpdec\mpdecimal-$(LibMpdecVersion)\LICENSE.txt">
        <DestName>libmpdec-license.txt</DestName>
      </_License>
      <_License Include="$(MSBuildProjectDirectory)\zlib\zlib-$(ZlibVersion)\LICENSE">
        <DestName>zlib-license.txt</DestName>
      </_License>
    </ItemGroup>
    <MakeDir Directories="$(OutDir)\licenses" />
    <Copy SourceFiles="@(_License)" DestinationFiles="@(_License->'$(OutDir)licenses\%(DestName)')" />
    <Exec Command="powershell.exe -NonInteractive -executionpolicy Unrestricted -file &quot;$(MSBuildProjectDirectory)\extract-sqlite-license.ps1&quot; &quot;$(MSBuildProjectDirectory)\sqlite\sqlite-$(SQLiteVersion)\sqlite3.h&quot; &quot;$(OutDir)licenses\sqlite-license.txt&quot;" />
  </Target>

  <!-- Capture dumpbin output for the shipped DLLs so toolchain/SDK changes
       (e.g. runner image, MSVC toolset) can be diffed against a baseline.
       See PR #29 for the validation checklist that motivated this. -->
  <Target Name="DumpBinReport" AfterTargets="Build">
    <ItemGroup>
      <DumpBinTarget Include="$(OutDir)MagPython.dll" />
      <DumpBinTarget Include="$(OutDir)libcrypto-$(OpenSslDllSuffix).dll" />
      <DumpBinTarget Include="$(OutDir)libssl-$(OpenSslDllSuffix).dll" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)dumpbin" />
    <Exec Command="dumpbin /headers &quot;%(DumpBinTarget.Identity)&quot; &gt; &quot;$(OutDir)dumpbin\%(DumpBinTarget.Filename)%(DumpBinTarget.Extension).headers.txt&quot;" />
    <Exec Command="dumpbin /imports &quot;%(DumpBinTarget.Identity)&quot; &gt; &quot;$(OutDir)dumpbin\%(DumpBinTarget.Filename)%(DumpBinTarget.Extension).imports.txt&quot;" />
    <Exec Command="dumpbin /exports &quot;%(DumpBinTarget.Identity)&quot; &gt; &quot;$(OutDir)dumpbin\%(DumpBinTarget.Filename)%(DumpBinTarget.Extension).exports.txt&quot;" />
    <Exec Command="dumpbin /loadconfig &quot;%(DumpBinTarget.Identity)&quot; &gt; &quot;$(OutDir)dumpbin\%(DumpBinTarget.Filename)%(DumpBinTarget.Extension).loadconfig.txt&quot;" />
  </Target>
