{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "github-actions": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^MagPython/openssl-version$/"
      ],
      "matchStrings": ["^(?<currentValue>.+?)\\s*$"],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "openssl",
      "packageNameTemplate": "openssl/openssl",
      "extractVersionTemplate": "^openssl-(?<version>3\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^MagPython/zlib-version$/"
      ],
      "matchStrings": ["^(?<currentValue>.+?)\\s*$"],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "zlib",
      "packageNameTemplate": "madler/zlib",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^MagPython/zstd-version$/"
      ],
      "matchStrings": ["^(?<currentValue>.+?)\\s*$"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "zstd",
      "packageNameTemplate": "facebook/zstd",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^MagPython/libffi-version$/"
      ],
      "matchStrings": ["^(?<currentValue>.+?)\\s*$"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "libffi",
      "packageNameTemplate": "libffi/libffi",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^MagPython/python-version$/"
      ],
      "matchStrings": ["^(?<currentValue>.+?)\\s*$"],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "python",
      "packageNameTemplate": "python/cpython",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^MagPython/nasm-version$/"
      ],
      "matchStrings": ["^(?<currentValue>.+?)\\s*$"],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "nasm",
      "packageNameTemplate": "netwide-assembler/nasm",
      "extractVersionTemplate": "^nasm-(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "loose"
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "MagPython/update-{{depName}}.sh {{newVersion}}"
    ],
    "fileFilters": [
      "MagPython/openssl-version",
      "MagPython/openssl-sha256",
      "MagPython/zlib-version",
      "MagPython/zlib-sha256",
      "MagPython/zstd-version",
      "MagPython/zstd-sha256",
      "MagPython/libffi-version",
      "MagPython/libffi-sha256",
      "MagPython/python-version",
      "MagPython/python-sha256",
      "MagPython/nasm-version",
      "MagPython/nasm-sha256"
    ],
    "executionMode": "update"
  },
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["openssl", "zlib", "zstd", "libffi", "python", "nasm"],
      "commitMessageTopic": "{{depName}} pin",
      "commitMessageAction": "Bump",
      "groupName": null
    },
    {
      "description": "Slow-moving build deps: one bundled PR per quarter. Tick the group on the Dependency Dashboard to get it early.",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["libffi", "nasm", "zlib", "zstd"],
      "groupName": "build deps",
      "groupSlug": "build-deps",
      "commitMessageTopic": "build dep pins",
      "schedule": ["* 0-5 1 1,4,7,10 *"],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Stay on the Python 3.14 line; minor bumps are done by hand.",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ]
}
