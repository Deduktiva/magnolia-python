# `*.d` above matches the .ctags.d directory too, which would silently
# swallow the OpenSSL 3.x tooling under openssl/.ctags.d/. Un-ignore it.
!/openssl/.ctags.d/
/openssl/**/*.s
/openssl/**/*.a
/openssl/**/*.so
/openssl/**/*.so.*
/openssl/**/*.dylib
/openssl/**/*.map
/openssl/**/*.pc
